; Engine configuration file.
config_version=5

[application]

config/name="Wardens"
config/description="An original elemental martial-arts adventure."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=3
scaling_3d/scale=0.6
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
global_illumination/gi/use_half_resolution=true
global_illumination/sdfgi/probe_ray_count=0
global_illumination/sdfgi/frames_to_converge=2
global_illumination/sdfgi/frames_to_update_light=4
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
environment/ssao/quality=0
environment/defaults/default_clear_color=Color(0.5, 0.7, 0.9, 1)
textures/default_filters/anisotropic_filtering_level=3
